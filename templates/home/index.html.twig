{% extends 'base.html.twig' %}

{% block title %}Hello
{% endblock %}

{% block body %}
	<header>
		<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
			<a class="navbar-brand" href="{{ path('home') }}">Home</a>
			<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav">
					{% if is_granted('ROLE_USER') %}
						<li class="nav-item">
							<a class="nav-link">Bienvenue</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_logout') }}">Se deconnecter</a>
						</li>
					{% endif %}
					{% if is_granted('ROLE_ADMIN') %}
						<li class="nav-item">
							<a class="nav-link p-2" href="{{ path('admin') }}">Administration</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_logout') }}">Se deconnecter</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('index') }}">Créer une carte</a>
					{% endif %}
					
				</ul>
			</div>
		</nav>
	</header>
	{{ render(controller('App\\Controller\\LoginController::index'))}}
{% endblock %}
