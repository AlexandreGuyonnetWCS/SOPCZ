{% extends 'base.html.twig' %}

{% block title %}SOPCZ
{% endblock %}

{% block body %}
	{% for message in app.flashes('success') %}
		<div class="alert alert-success">
			{{ message }}
		</div>
	{% endfor %}
	{% if app.user %}
		<div class="container">
			<div class="row">

				<h1 class="text-white text-center mt-5">Bienvenue
					{{app.user.nom }}
					{{app.user.prenom }}</h1>
				<div class="col-md-6 p-3 text-center">
					<h2 class="text-white">Vous êtes dans votre espace<br>
						de gestion de carte</h2>
					<p class="text-white mt-5">Vous pouvez créer une carte, en cliquant sur le bouton
					</p>
				</div>
				<div class="col-md-6 text-center">
					<a href="{{ path('index') }}" class="btn btn-primary mt-5">Créer une carte</a>
				</div>
			</div>
		</div>
	{% else %}
		{{ render(controller('App\\Controller\\LoginController::index'))}}
	{% endif %}
{% endblock %}
