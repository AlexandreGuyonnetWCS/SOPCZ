{% block body %}
	<div class="container mt-3">
		<div class="row">
			<div class="col-md-12">
				<h1 class="text-white text-center">Page de recherche des autorisations</h1>
				<form action="{{ path('base_search') }}" method="post">
					{{ form_start(form) }}
					<input type="hidden" name="nom" value="{{ nom }}">
					<input type="hidden" name="prenom" value="{{ prenom }}">
					{{ form_widget(form) }}

					<input class="btn btn-primary" type="submit" value="Rechercher"/>
					{{ form_end(form) }}
				</form>
			</div>
		</div>
{% endblock %}
