{% extends 'base.html.twig' %}

{% block title %}Mise à jour du mot de passe
{% endblock %}


{% block body %}
	{% for message in app.flashes('success') %}
		<div class="alert alert-success">
			{{ message }}
		</div>
	{% endfor %}
	<div class="container">
		<div class="row">
			<div class="col">
				<h1 class="text-white">Bienvenue</h1>
				<p class="text-white">Vous pouvez maintenant mettre à jour votre mot de passe.</p>

				{{ form_start(form) }}
				<div class="form-group">
					{{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
					{{ form_errors(form.password) }}
				</div>
				<div class="d-flex justify-content-end">
					<button class="btn btn-success mt-2 mb-5">Mettre à jour</button>
				</div>
				{{ form_end(form) }}

			</div>
		</div>
	{% endblock %}
