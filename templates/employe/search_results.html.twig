{% extends 'base.html.twig' %}

{% block body %}
	<h1 class="text-center text-white mt-5 mb-3">Résultats de la recherche</h1>
	<div class="container">
		{% if employe|length %}
			{% for employe in employe %}
				<div class="card mb-5">
					<div class="card-header">
						<h3 class="card-title text-center">Fiche Collaborateur</h3>
					</div>
					<div class="row g-0">
						<div class="col-md-3">
							<div class="card-image-top"><img src="{{ asset('uploads/employes/' ~ employe.photo) }}" alt="photo" class="img-fluid"></div>
						</div>
						<div class="col-md-9">
							<ul class="list-group list-group-flush">
								<li class="list-group-item">{{ employe.genre }}
									{{ employe.nom }}
									{{ employe.prenom }}</li>
								<li class="list-group-item">Département :
									{{ employe.departement}}</li>
								<li class="list-group-item">Poste :
									{{ employe.poste}}</li>
								<li class="list-group-item">Date de visite médicale :
									{{ employe.amco|date('d/m/Y')}}</li>
							</div>
						</div>
					</div>
				{% endfor %}

				<a class="btn btn-primary mb-5" href="{{ path('index') }}">Retour à la recherche</a>
				<div class="row">
					{% for baseAutorisation in baseAutorisations %}
						{% for diplome in baseAutorisation.Diplome %}

							<div class="col-auto mb-5 mt-5">
								<div class="card" style="width: 18rem;">
									<ul class="list-group list-group-flush">
										<li class="list-group-item">{{ diplome.type }}</li>
										<li class="list-group-item">{{ diplome.nom }}</li>
										<li class="list-group-item">{{ diplome.categorie }}</li>
										<li class="list-group-item">Fait le :
											{{ baseAutorisation.createdAt|date('d/m/Y') }}</li>
										<li class="list-group-item">validité :
											{{ diplome.validite }}</li>
										{% for centre in baseAutorisation.centre %}
											<li class="list-group-item">{{ centre.nom }}</li>
										{% endfor %}
									</ul>
									<div class="card-footer">
										<a class="btn btn-primary" href="{{ path('carte_pdf', { id: baseAutorisation.id }) }}">Télécharger</a>
										<a class="btn btn-primary" href="{{ path('show', { id: baseAutorisation.id }) }}">Voir</a>
									</div>
								</div>
							{% endfor %}
						</div>
					{% endfor %}
				</div>
			{% else %}
				<div class="text-center">
					<p class="text-white text-center mt-5">Nous sommes désolés mais votre recherche ne correspond à aucun collaborateur</p>
					<a class="btn btn-primary mt-5" href="{{ path('index') }}">Retour à la recherche</a>
				</div>
			{% endif %}
		</div>
	{% endblock %}
