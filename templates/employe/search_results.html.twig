{% extends 'base.html.twig' %}

{% block body %}
	<h1 class="text-center text-white mt-5 mb-3">Résultats de la recherche</h1>
	<div class="container">
		{% if datas|length %}
			{% for i in datas |slice(start=0, length=1) %}
				<div class="card mb-5">
					<div class="card-header">
						<h3 class="card-title text-center">Fiche Collaborateur</h3>
					</div>
					<div class="row g-0">
						<div class="col-md-3">
							<div class="card-image-top"><img src="{{ asset('uploads/employes/' ~ datas[0].photo) }}" alt="photo" class="img-fluid"></div>
						</div>
						<div class="col-md-9">
							<ul class="list-group list-group-flush">
								<li class="list-group-item">{{ datas[0].genre }}
									{{ datas[0].nom }}
									{{ datas[0].prenom }}</li>
								<li class="list-group-item">Département :
									{{ datas[0].departement}}</li>
								<li class="list-group-item">Poste :
									{{ datas[0].poste}}</li>
								<li class="list-group-item">Date de visite médicale :
									{{ datas[0].amco|date('d/m/Y')}}</li>
							</div>
						</div>
					</div>
				{% endfor %}

				<a class="btn btn-primary mb-5" href="{{ path('index') }}">Retour à la recherche</a>
				<div class="row">
				<pre>
					{{ dump(datas) }}
				</pre>

					{# {% for data in datas %}
							<div class="col-auto mb-5 mt-5">
								<div class="card" style="width: 18rem;">
									<ul class="list-group list-group-flush">
										<li class="list-group-item">{{ data.diplomeType}}</li>
										<li class="list-group-item">{{ data.diplomeName }} </li>
										<li class="list-group-item">{{ data.diplomeCategory }}</li>
										<li class="list-group-item">Fait le :
											{{ data.createdAt|date('d/m/Y') }}</li>
										<li class="list-group-item">validité :
											{{ data.endedAt|date('d/m/Y') }}</li>
										
											<li class="list-group-item">{{ data.centre }}</li>
		
									</ul>
									<div class="card-footer">
										<a class="btn btn-primary" href="{{ path('carte_pdf', { id: data.id }) }}">Télécharger</a>
										<a class="btn btn-primary" href="{{ path('show', { id: data.id }) }}">Voir</a>
									</div>
								</div>
							</div>
					{% endfor %} #}
				</div>
			{% else %}
				<div class="text-center">
					<p class="text-white text-center mt-5">Nous sommes désolés mais votre recherche ne correspond à aucun collaborateur</p>
					<a class="btn btn-primary mt-5" href="{{ path('index') }}">Retour à la recherche</a>
				</div>
			{% endif %}
		</div>
	{% endblock %}
