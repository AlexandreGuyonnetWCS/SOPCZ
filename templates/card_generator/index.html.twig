{% extends 'base.html.twig' %}

{% block title %}Gestionnaire de cartes{% endblock %}

{% block body %}
<div class="container">
<div class="row">
    <div class="col-md-12">
        <h1>Bienvenue dans votre gestionnaire de cartes</h1>
    </div>
</div>
<h1 class="text-center mt-5">Rechercher des employes</h1>

<div class="container">
    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.prenom) }}
        <button type="submit">Rechercher</button>
    {{ form_end(form) }}
    
</div>

{% endblock %}
