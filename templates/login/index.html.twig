<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}SOPCZ
			{% endblock %}
		</title>
		<link
		rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
		{# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
		{% endblock %}
	</head>
	<body></body>

</html>

{% block body %}
	{% if error %}
		<div class="alert alert-warning alert-dismissible fade show" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	{% endif %}
	<div class="container">
		<div class="row">
			<div class="col-md-6 mt-5 align-self-center">
				<img src="{{ asset('uploads/logos/logo.png') }}" alt="sopcz" class="img-fluid mx-auto d-block">
			</div>
			<div class="col-md-6 mt-5">
				<h1 class="text-center text-white">Bienvenue</h1>
				<h4 class="text-center text-white mb-5">Connectez-vous pour accéder à votre espace de gestion</h4>
				<div class="card p-1 d-flex">
					<div class="card-body">
						<form action="{{ path('app_login') }}" method="post">
							<label class="mb-2" for="username">Votre e-mail:</label>
							<input class="form-control" type="text" id="username" name="_username" value="{{ last_username }}">

							<label class="mt-3 mb-2" for="password">Votre mot de passe:</label>
							<input class="form-control mb-2" type="password" id="password" name="_password">
							<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
							<div class="align-self-end">
								<button class="btn btn-primary mt-3" type="submit">Connexion</button>
							</div>
						</form>
					</div>
				</div>
			{% endblock %}
