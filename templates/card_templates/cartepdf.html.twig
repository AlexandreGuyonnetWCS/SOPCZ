	{% elseif baseAutorisations.type == 'Habilitation électrique' %}
		<div class="container-2">
			{% for entreprise in entreprise %}
				<table class="tg-1">
					<thead>
						<tr>
							<th class="tg-1men"><img class="logo-2" src="{{ ( 'uploads/logos/' ~ entreprise.logo) }}"/></th>
							<th class="tg-6men" colspan="3">TITRE D'HABILITATION <br>ELECTRIQUE</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="tg-8men" colspan="4">Le titre d’habilitation formalise la reconnaissance, par l’employeur, de la capacité d’un salarié à travailler en sécurité sur des ouvrages électriques.<br>
								
							</td>
						</tr>
						<tr>
							<td class="tg-8men" colspan="4">
								Il est établi en tenant compte des éléments suivants :<br>
							</td>
						</tr>
						<tr>
							<td class="tg-8men" colspan="4">
								- La compétence du salarié (qualification pour les tâches à exécuter + formation théorique et pratique sur la prévention des risques électriques).
							</td>
						</tr>
						<tr>
							<td class="tg-8men" colspan="4">
								- L’aptitude médicale (délivrée par le médecin de prévention).
							</td>
						</tr>
						<tr>
							<td class="tg-8men" colspan="4">
								- Le comportement compatible avec la bonne exécution du travail (déterminé par la hiérarchie).
							</td>
						</tr>
						<tr>
							<td class="tg-5men" colspan="2"><strong>Avis d'habilitation n° :</strong>
								{% if numero|length %}
							{{ numero[0].number }}
							{% endif %}
							</td>
							<td class="tg-5men" colspan="2"><strong>Nom, Prénom:</strong>
								{{ baseAutorisations.genre }}
								{{ baseAutorisations.nom }}
								{{ baseAutorisations.prenom }}</td>
						</tr>
						<tr>
							<td class="tg-5men" colspan="2"><strong>Délivré par :</strong>
								{% if numero|length %}
								{{ numero[0].centre }}
								{% endif %}</td>
							<td class="tg-5men" colspan="2"><strong>qui occupe le poste de :</strong>
								{{ baseAutorisations.poste }}</td>
						</tr>
						<tr>
							<td class="tg-5men" colspan="2"><strong>Date de de formation :</strong>
								{{ baseAutorisations.creation|date('d/m/Y') }}</td>
							<td class="tg-5men" colspan="2"><strong>Validité du titre :</strong>
								{{ baseAutorisations.validite|format_datetime(pattern='dd/MM/yyyy', timezone='Europe/Paris') }}</td>
						</tr>
						<tr>
							<td class="tg-5mez" colspan="4"><strong>Aptitude médicale validée par l'AMCO en :</strong>
								{{ baseAutorisations.amco|format_datetime(pattern='MM/yyyy', timezone='Europe/Paris') }}</td>
						</tr>
					</tbody>
				</table>
				<br>
				<table class="tg">
					<thead>
						<tr>
							<th class="tg-exhm" rowspan="2">PERSONNEL</th>
							<th class="tg-exhm" rowspan="2">Symbole
								<br>d'habilitation et attribut</th>
							<th class="tg-exhm" colspan="3">Champ d'application</th>
						</tr>
						<tr>
