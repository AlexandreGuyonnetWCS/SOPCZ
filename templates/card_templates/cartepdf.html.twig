<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>Carte</title>
		<style>
			body {
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
			}
			.card-container {
				background: white;
				border-radius: 10px;
				width: 22rem;
				height: 12rem;
				position: relative;
				margin-top: 2rem;
				margin-bottom: 2rem;
			}
			.card-container-full {
				background: white;
				border: 1px solid black;
				width: 44rem;
				height: 14rem;
				position: relative;
				margin-top: 2rem;
				margin-bottom: 2rem;
			}
			.container-2 {
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				width: 80%;
				height: 33%;
			}
			.card-header {
				font-size: 1rem;
				font-family: sans-serif;
				background-color: #000059;
				color: white;
				height: 2.5rem;
				border-radius: 10px 10px 0 0;
			}
			.card-photo {
				position: absolute;
				top: 0.5rem;
				left: 1rem;
				width: 4.5rem;
				height: 6rem;
				border-radius: 5%;
				background-color: white;
			}
			.photo {
				width: 4.5rem;
				height: 6rem;
				border-radius: 5%;
			}
			.logo {
				position: absolute;
				height: 2rem;
				top: 5px;
				right: 5px;
			}
			.logo-2 {
				height: 4rem;
				top: 5px;
				right: 5px;
			}
			.card-intitule {
				position: relative;
				font-size: 1rem;
				font-family: sans-serif;
				font-weight: bold;
				color: black;
				left: 6rem;
				text-decoration: underline;
				padding-top: 0.5rem;
			}
			.card-body {
				font-size: 1rem;
				font-family: sans-serif;
				background-color: #f4e3d7;
				color: black;
				height: 7rem;
			}
			.card-body-2 {
				font-size: 0.5rem;
				font-family: sans-serif;
				font-weight: bold;
				background-color: #f4e3d7;
				color: black;
				height: 132px;
				border-radius: 10px 10px 0 0;
				padding: 10px;

			}
			.card-nom {
				position: relative;
				top: 3rem;
				left: 2rem;
				font-size: 1rem;
				font-family: sans-serif;
				font-weight: bold;
				color: black;
			}
			.card-footer {
				font-size: 1rem;
				font-family: sans-serif;
				background-color: #aa0000;
				color: white;
				height: 2.5rem;
				border-radius: 0 0 10px 10px;
			}
			.card-diplome-logo {
				position: relative;
				top: 0.5rem;
				left: 0.5rem;
				height: 1.5rem;
			}
			.card-diplome-type {
				position: relative;
				top: -1.2rem;
				left: 4rem;
				font-size: 0.8rem;
				font-family: sans-serif;
				font-weight: bold;
				color: black;
				background-color: white;
				border-radius: 5px 0 0 5px;
				border: 1px solid white;
				height: 13px;
				padding: 0.5rem;
				width: 5rem;
				text-align: center;
			}
			.card-diplome-nom {
				position: relative;
				top: -50px;
				left: 10.1rem;
				font-size: 0.8rem;
				font-family: sans-serif;
				font-weight: bold;
				color: white;
				background-color: #aa0000;
				border-radius: 0 5px 5px 0;
				border-top: 1px solid white;
				border-right: 1px solid white;
				border-bottom: 1px solid white;
				height: 13px;
				padding: 0.5rem;
				width: 10rem;
				text-align: left;
			}
			.card-dg {
				position: relative;
				top: 0.25rem;
				left: 0.5rem;
				font-size: 0.5rem;
				font-family: sans-serif;
				font-weight: bold;
				color: black;
				background-color: white;
				border-radius: 5px 0 0 5px;
				border: 1px solid white;
				height: 1rem;
				padding: 0.5rem;
				width: 12rem;
				text-align: left;
			}
			.card-signature {
				position: relative;
				top: -1.87rem;
				left: 13.5rem;
				height: 2rem;
				width: 8rem;
				background-color: white;
				border-radius: 0 5px 5px 0;
				border: 1px solid white;
			}

			button {
				position: relative;
				top: 1rem;
				left: 3rem;
				height: 2rem;
				width: 8rem;
				background-color: green;
				color: white;
				border-radius: 5px;
				border: 1px solid white;
			}
			.tg {
				border-collapse: collapse;
				border-spacing: 0;
				width: 40rem;
				height: 350px;
			}
			.tg td {
				border-color: black;
				border-style: solid;
				border-width: 1px;
				font-family: Arial, sans-serif;
				font-size: 11px;
				overflow: hidden;
				padding: 2px 2px;
				word-break: normal;
			}
			.tg th {
				border-color: black;
				border-style: solid;
				border-width: 1px;
				font-family: Arial, sans-serif;
				font-size: 11px;
				font-weight: normal;
				overflow: hidden;
				padding: 2px 2px;
				word-break: normal;
			}
			.tg .tg-9hzl {
				background-color: #000000;
				border-color: inherit;
				color: #000000;
				font-size: 10px;
				font-weight: bold;
				text-align: center;
				vertical-align: top;
			}
			.tg .tg-exhm {
				border-color: inherit;
				color: #000000;
				font-family: Arial, sans-serif;
				font-weight: bold;
				font-size: 10px;
				text-align: center;
			}
			.tg .tg-exh {
				border-color: inherit;
				color: #000000;
				font-family: Arial, sans-serif;
				font-weight: bold;
				font-size: 10px;
				text-align: top !important;
				vertical-align: left !important;
			}
			.tg .tg-6ia5 {
				background-color: #000000;
				border-color: inherit;
				color: #000000;
				font-weight: bold;
				font-family: Arial, sans-serif;
				font-size: 10px;
				text-align: center;
				vertical-align: top;
			}
			.tg .tg-7fzc {
				border-color: #000000;
				color: #000000;
				font-family: Arial, sans-serif;
				font-weight: bold;
				font-size: 10px;
				text-align: left;
				vertical-align: top;
			}
			.tg .tg-7fzs {
				border-left-color: #000000;
				border-right-color: white;
				font-family: Arial, sans-serif;
				font-weight: bold;
				font-size: 10px;
				text-align: center;
			}
			.tg .tg-7fzd {
				border-right-color: white;
				border-left-color: white;
				border-top-color: #000000;
				border-bottom-color: #000000;
				font-family: Arial, sans-serif;
				font-weight: bold;
				font-size: 10px;
				text-align: left;
			}
			.tg .tg-7fzg {
				border-top-color: #000000;
				border-bottom-color: #000000;
				border-right-color: white;
				border-left-color: white;
				font-family: Arial, sans-serif;
				font-weight: bold;
				font-size: 10px;
				text-align: right;	
			}
			.tg .tg-7fzk {
				border-top-color: #000000;
				border-bottom-color: #000000;
				border-right-color: #000000;
				border-left-color: white;
				font-family: Arial, sans-serif;
				font-weight: bold;
				font-size: 10px;
				text-align: left;	
			}
			.tg .tg-73oq {
				border-color: inherit;
				text-align: left;
				vertical-align: top;
				font-family: Arial, sans-serif;
				font-weight: bold;
				font-size: 10px;
			}
			.tg-1 {
				border-collapse: collapse;
				border-spacing: 0;
				border-color: black;
				border-style: solid;
				border-width: 1px;
				width: 40rem;
				min-height: 20rem;
			}
			.tg-1 td {
				
				font-family: Arial, sans-serif;
				font-size: 10px;
				overflow: hidden;
				padding: 2px 2px;
				padding-left: 10px;
				word-break: normal;
			}
			.tg-1 .tg-6men {
				font-family: Arial, Helvetica, sans-serif !important;
				font-size: 20px;
				font-weight: bold;
				text-align: center;
			}
			.tg-1 th {
				font-family: Arial, sans-serif;
				font-size: 10px;
				font-weight: normal;
				overflow: hidden;
				padding: 2px 2px;
				word-break: normal;
			}
			.tg-5men {
				font-family: Arial, Helvetica, sans-serif !important;
				font-size: 10px;
				vertical-align: top;
				height: 30px;
			}
			.tg-1 .tg-1men {	
				height: 90px;
			}
			.tg-8men {
				font-family: Arial, Helvetica, sans-serif !important;
				font-size: 10px;
				vertical-align: top;
				height: 20px;
			}
			.tg-5mez {
				font-family: Arial, Helvetica, sans-serif !important;
				font-size: 10px;
				vertical-align: top;
				border-bottom: 1px solid black;
				height: 30px;
			}
			.signelec {
				max-height: 30px;
			}
		</style>
	</head>
	<body>
		{% if baseAutorisations.type == 'CACES' %}
			{% for entreprise in entreprise %}
				<div class="card-container">
					<div class="card-header">
						<img class="logo" src="{{ ('uploads/logos/' ~ entreprise.logo) }}"/>
					</div>
					<div class="card-photo">
						<img class="photo" src="{{ ('uploads/employes/' ~ baseAutorisations.photo) }}"/>
					</div>
					<div class="card-body">
					
						<div class="card-intitule">AUTORISATION DE CONDUITE</div>
						<div class="card-nom">
							{{ baseAutorisations.genre }}
							{{ baseAutorisations.nom }}
							{{ baseAutorisations.prenom }}
						</div>
					</div>
					<div class="card-footer">
						<div>
							<img class="card-diplome-logo" src="{{ ('uploads/images/' ~ baseAutorisations.image) }}" alt=""/>
						</div>
						<div class="card-diplome-type">
							{{ baseAutorisations.type }}
						</div>
						<div class="card-diplome-nom">
							{{ baseAutorisations.name }}
							{{ baseAutorisations.categories }}
						</div>
					</div>
				</div>
				<div class="card-container">
					<div class="card-body-2">
						Je soussigné,
						{{ entreprise.genreDirecteur }}
						{{ entreprise.nomDirecteur }}
						{{ entreprise.prenomDirecteur }}
						, Directeur Général ,
						<br>
						<br>
						certifie que
						{{ baseAutorisations.genre}}
						{{ baseAutorisations.nom}}
						{{baseAutorisations.prenom}}
						<br>
						qui occupe le poste de
						{{ baseAutorisations.poste }}
						<br><br>
						m'a présenté le diplôme suivant :
						{{ baseAutorisations.type }}
						{{ baseAutorisations.name }}
						{{ baseAutorisations.categories }}
						<br><br>
						délivré par
						{{ baseAutorisations.centre }}
						Aptitude médicale validée par l'AMCO en :
						{{ baseAutorisations.amco|date('m/Y') }}
						<br><br>
						En foi de quoi j'autorise :
						{{ baseAutorisations.genre}}
						{{ baseAutorisations.nom}}
						{{baseAutorisations.prenom}}
						<br>
						A conduire les engins correspondant aux categories:
						{{ baseAutorisations.categories }}
						<br>
						<br>
						validité :
						{{ baseAutorisations.validite|date('d/m/Y') }}
						<br>
					</div>
					<div class="card-footer">
						<div class="card-dg">
							{{ entreprise.genreDirecteur }}
							{{ entreprise.nomDirecteur }}
							{{ entreprise.prenomDirecteur }}
							<br>Directeur Général
						</div>
						<div>
							<img class="card-signature" src="{{ ('uploads/signatures/' ~ entreprise.signatureDirecteur) }}" alt=""/>
						</div>
					</div>
				</div>
			
			{% endfor %}
		</body>
	{% elseif baseAutorisations.type == 'Travaux en hauteur' and baseAutorisations.name == 'Echafaudage' %}
