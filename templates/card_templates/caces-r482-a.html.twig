{% for employe in employe %}	
				
<div class="col-auto">
	<div class="card" style="width: 18rem;">
		<div class="card-body">
			<h5 class="card-title">{{ employe.nom }}</h5>
			<h6 class="card-subtitle mb-2 text-muted">{{ employe.prenom }}</h6>
			<p class="card-text">{{ employe.departement }}</p>
			<p class="card-text">{{ employe.poste }}</p>
		</div>
	</div>
{% endfor %}
{% for diplome in diplome %}
<div class="col-auto">
	<div class="card" style="width: 18rem;">
		<div class="card-body">
			<h5 class="card-title">{{ diplome.type }}</h5>
			<h6 class="card-subtitle mb-2 text-muted">{{ diplome.nom }}</h6>
			<p class="card-text">{{ diplome.categorie }}</p>
		</div>
	</div>
</div>
{% endfor %}
	{% for entreprise in entreprise %}
		<div class="col-auto">
			<div class="card" style="width: 18rem;">
				<div class="card-body">
					<h5 class="card-title">{{ entreprise.nom }}</h5>
					<h6 class="card-subtitle mb-2 text-muted">{{ entreprise.adresse }}</h6>

					<p class="card-text">{{ entreprise.contacte }}</p>
					<p class="card-text">{{ entreprise.nomDirecteur }}</p>
				</div>
			</div>
		</div>
		{% endfor %}
